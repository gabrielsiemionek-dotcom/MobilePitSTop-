<script>
(function(){
  /* Numbers come from window.MPS_REVIEWS in sitewide header injection, so
     one edit updates every page. The values in the markup above are
     fallbacks that render instantly — if the config is missing this does
     nothing rather than blanking the badge. */
  var cfg = window.MPS_REVIEWS;
  if(!cfg) return;
  var badge = document.getElementById('mpsRvBadge');
  var score = document.getElementById('mpsRvScore');
  var count = document.getElementById('mpsRvCount');
  if(!badge) return;
  var s = cfg.score != null ? String(cfg.score) : null;
  var n = cfg.count != null ? Number(cfg.count) : null;
  if(score && s) score.textContent = s;
  if(count && n) count.textContent = n + ' Google reviews';
  if(cfg.url)    badge.setAttribute('href', cfg.url);
  if(s && n){
    badge.setAttribute('aria-label',
      'Rated ' + s + ' out of 5 from ' + n + ' Google reviews. Opens Google in a new tab.');
  }
})();
</script>

