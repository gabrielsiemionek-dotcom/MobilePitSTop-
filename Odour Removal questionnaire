  var optionAKicker = pfRoot.querySelector('#optionAKicker');
  var optionATitle  = pfRoot.querySelector('#optionATitle');
  var optionADesc   = pfRoot.querySelector('#optionADesc');
  var optionABest   = pfRoot.querySelector('#optionABest');
  var optionBCard   = pfRoot.querySelector('[data-cigarette-only]');

  var steps      = Array.from(track.querySelectorAll('.step'));
  var STEP_COUNT = steps.length;

  function escHtml(str){
    return String(str)
      .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
      .replace(/"/g,'&quot;').replace(/'/g,'&#39;');
  }

  function setHTML(el, html){
    if(el && el.innerHTML !== html) el.innerHTML = html;
  }

  var FIELD_ID = '18506559';
  (function captureGclid(){
    try{
      var qs = new URLSearchParams(window.location.search);
      var types = ['gclid','gbraid','wbraid'];
      for(var i = 0; i < types.length; i++){
        var v = qs.get(types[i]);
        if(v){
          var tagged = types[i] + ':' + v;
          try{ localStorage.setItem('captured_gclid', tagged); }catch(e){}
          try{ sessionStorage.setItem('captured_gclid', tagged); }catch(e){}
          break;
        }
      }
    }catch(e){}
  })();
  function getGclid(){
    var v = null;
    try{ v = localStorage.getItem('captured_gclid'); }catch(e){}
    if(!v){ try{ v = sessionStorage.getItem('captured_gclid'); }catch(e){} }
    return v || null;
  }

  var PRICES = {
    optionA: {
      cigarette: { '3door':200, '5door':230, '7seater':260 },
      milk:      { '3door':150, '5door':160, '7seater':170 },
      bio:       { '3door':200, '5door':210, '7seater':220 }
    },
    optionB: {
      cigarette: { '3door':120, '5door':130, '7seater':140 }
    }
  };

  var VEHICLE_LABELS = {
    '3door':'3-Door Car',
    '5door':'5-Door / 5-Seater Car',
    '7seater':'5-Door / 7-Seater Car'
  };

  var SMELL_LABELS = {
    cigarette: 'Cigarette smell',
    milk:      'Milk smell',
    bio:       'Bio / bodily fluid smell'
  };

  var SERVICE_LABELS = {
    optionA: {
      cigarette: 'Ozone Treatment',
      milk:      'Ozone Treatment',
      bio:       'Ozone Treatment + Chlorine Dioxide Tablets'
    },
    optionB: {
      cigarette: 'Chlorine Dioxide Treatment'
    }
  };

  var ACUITY = {
    baseUrl: 'https://mobilepitstop.as.me/',
    typeMap: {
      '3door|cigarette|optionA':  92502297,
      '5door|cigarette|optionA':  92502302,
      '7seater|cigarette|optionA':92502309,
      '3door|cigarette|optionB':  92502332,
      '5door|cigarette|optionB':  92502323,
      '7seater|cigarette|optionB':92502318,
      '3door|milk|optionA':       92502362,
      '5door|milk|optionA':       92502371,
      '7seater|milk|optionA':     92502382,
      '3door|bio|optionA':        92502427,
      '5door|bio|optionA':        92502425,
      '7seater|bio|optionA':      92502407
    }
  };

  var ACUITY_QUOTE_ID = 84640446;

  var state = { step:0, vehicle:null, smell:null, service:null };

  function buildTrackedAcuityUrl(appointmentTypeId){
    if(!appointmentTypeId) appointmentTypeId = ACUITY_QUOTE_ID;
    var url = ACUITY.baseUrl + '?appointmentType=' + encodeURIComponent(appointmentTypeId);
    var gclid = getGclid();
    if(gclid){
      url += '&' + encodeURIComponent('field:' + FIELD_ID) + '=' + encodeURIComponent(gclid);
    }
    return url;
  }

  function fmtGBP(n){ return '£' + Number(n || 0).toFixed(0); }

  function getPrice(){
    if(!state.vehicle || !state.smell || !state.service) return 0;
    return (PRICES[state.service] && PRICES[state.service][state.smell] && PRICES[state.service][state.smell][state.vehicle]) || 0;
  }

  function getAcuityKey(){
    if(!state.vehicle || !state.smell || !state.service) return null;
    return state.vehicle + '|' + state.smell + '|' + state.service;
  }

  function getAppointmentTypeId(){
    var key = getAcuityKey();
    if(!key) return ACUITY_QUOTE_ID;
    return ACUITY.typeMap[key] || ACUITY_QUOTE_ID;
  }

  function buildAcuityUrl(){
    return buildTrackedAcuityUrl(getAppointmentTypeId());
  }

  var _dotEls = null;
  function buildDots(){
    dotsEl.innerHTML = '';
    _dotEls = [];
    for(var i = 0; i < STEP_COUNT; i++){
      var d = document.createElement('span');
      d.className = 'dot';
      dotsEl.appendChild(d);
      _dotEls.push(d);
    }
  }
  function renderDots(){
    if(!_dotEls) buildDots();
    _dotEls.forEach(function(d, i){ d.classList.toggle('on', i === state.step); });
  }

  function updateTreatmentCards(){
    if(!state.smell) return;

    optionBCard.style.display = state.smell === 'cigarette' ? '' : 'none';

    if(state.smell === 'cigarette'){
      optionAKicker.textContent = 'Recommended Treatment';
      optionATitle.textContent  = 'Full Interior Steam Shampoo + Extraction + Ozone Treatment';
      optionADesc.textContent   = 'Full interior steam shampoo and extraction including mats, carpets, seats, boot and headliner, finished with ozone treatment.';
      optionABest.textContent   = 'Deep smoke contamination trapped in fabrics, carpets, headliner and the air system.';
    }
    if(state.smell === 'milk'){
      optionAKicker.textContent = 'Recommended Treatment';
      optionATitle.textContent  = 'Milk Odour Removal + Ozone Treatment';
      optionADesc.textContent   = 'Full interior steam, shampoo and extraction to remove milk residue from fabrics, followed by ozone treatment to neutralise remaining odour.';
      optionABest.textContent   = 'Milk spills and sour organic smells that need the physical source removed before odour treatment.';
    }
    if(state.smell === 'bio'){
      optionAKicker.textContent = 'Recommended Treatment';
      optionATitle.textContent  = 'Bio Odour Removal + Ozone Treatment + Chlorine Tablets';
      optionADesc.textContent   = 'Full interior odour reset with ozone treatment. Chlorine dioxide tablets will also be provided after the clean in case the odour comes back.';
      optionABest.textContent   = 'Bio odours, bodily fluid smells and strong organic contamination where a backup after-treatment may be needed.';
    }
  }

  function updateOptionPrices(){
    var optionAPrice = pfRoot.querySelector('[data-price-option="optionA"]');
    var optionBPrice = pfRoot.querySelector('[data-price-option="optionB"]');

    if(!state.vehicle || !state.smell){
      if(optionAPrice) optionAPrice.textContent = '£0';
      if(optionBPrice) optionBPrice.textContent = '£0';
      return;
    }
    if(optionAPrice) optionAPrice.textContent = fmtGBP((PRICES.optionA[state.smell] && PRICES.optionA[state.smell][state.vehicle]) || 0);
    if(optionBPrice) optionBPrice.textContent = state.smell === 'cigarette'
      ? fmtGBP(PRICES.optionB.cigarette[state.vehicle])
      : 'N/A';
  }

  function syncNav(){
    btnBack.disabled = state.step === 0;
    btnNext.disabled = !isAnswered(state.step) || state.step === STEP_COUNT - 1;

    var noteStr = !state.vehicle   ? 'Choose your car size first'
      : !state.smell   ? 'Now choose the odour type'
      : !state.service ? 'Now choose the treatment'
      : 'Ready to book';
    if(noteEl.textContent !== noteStr) noteEl.textContent = noteStr;
  }

  function updateTotalsAndPills(){
    updateTreatmentCards();
    updateOptionPrices();

    var price = getPrice();
    var priceStr    = (!state.vehicle || !state.smell || !state.service) ? '£0' : fmtGBP(price);
    var finalNoteStr = 'Ready to book when you are.';

    if(totalEl.textContent      !== priceStr)    totalEl.textContent      = priceStr;
    if(finalTotalEl.textContent !== priceStr)     finalTotalEl.textContent  = priceStr;
    if(finalNoteEl.textContent  !== finalNoteStr) finalNoteEl.textContent   = finalNoteStr;

    var pills = [];
    if(state.vehicle){
      pills.push('<span class="pill"><strong>Vehicle:</strong> ' + escHtml(VEHICLE_LABELS[state.vehicle]) + '</span>');
    }
    if(state.smell){
      pills.push('<span class="pill"><strong>Odour:</strong> ' + escHtml(SMELL_LABELS[state.smell]) + '</span>');
    }
    if(state.service){
      var serviceLabel = SERVICE_LABELS[state.service][state.smell] || 'Selected treatment';
      pills.push('<span class="pill"><strong>Service:</strong> ' + escHtml(serviceLabel) + '</span>');
      pills.push('<span class="pill"><strong>Total:</strong> ' + fmtGBP(price) + '</span>');
    }

    setHTML(pillsEl, pills.length
      ? pills.join('')
      : '<span class="pill"><strong>Ready:</strong> Choose your options above</span>'
    );
  }

  function isAnswered(stepIndex){
    switch(stepIndex){
      case 0: return !!state.vehicle;
      case 1: return !!state.smell;
      case 2: return !!state.service;
      case 3: return true;
      default: return true;
    }
  }

  function clearStepSelection(stepIndex){
    var stepEl = steps[stepIndex];
    if(!stepEl) return;
    stepEl.querySelectorAll('.opt[role="option"]').forEach(function(o){ o.setAttribute('aria-selected','false'); });
  }

  function clearAllSelections(){
    steps.forEach(function(stepEl){
      stepEl.querySelectorAll('.opt[role="option"]').forEach(function(o){ o.setAttribute('aria-selected','false'); });
    });
  }

  /* ---- scrolling, matched to the other questionnaires -------------------
     The old version called pfRoot.scrollIntoView() on every step, including
     the first. With a reviews badge above the block that dragged the page
     straight past it on load. This anchors on the wizard, and never scrolls
     on question one. */
  var MOTION_OK = !(window.matchMedia &&
                    window.matchMedia('(prefers-reduced-motion: reduce)').matches);

  function headerOffset(){
    var tallest = 0;
    var nodes = document.querySelectorAll('header, .Header, #header, .sqs-announcement-bar-dropzone');
    for(var i = 0; i < nodes.length; i++){
      var el = nodes[i], cs = window.getComputedStyle(el);
      if(cs.position !== 'fixed' && cs.position !== 'sticky') continue;
      var r = el.getBoundingClientRect();
      if(r.top <= 4 && r.height > 0) tallest = Math.max(tallest, r.height);
    }
    return tallest ? tallest + 12 : 16;
  }

  /* =====================================================================
     Scrolling — deliberately almost never happens here.

     No car visual and only three short questions, so the whole block fits
     on a phone screen. Scrolling on every answer just yanked the page.

     Only scrolls if the question isn't visible at all: the block has been
     scrolled off the top, or sits entirely below the fold.
     ===================================================================== */
  function scrollToWidgetTop(){
    var anchor = pfRoot.querySelector('.wizard') || pfRoot;
    var off = headerOffset();
    var r   = anchor.getBoundingClientRect();
    var vh  = window.innerHeight || document.documentElement.clientHeight;

    var hiddenAbove = r.bottom < off + 40;
    var hiddenBelow = r.top    > vh - 80;
    if(!hiddenAbove && !hiddenBelow) return;

    var y = Math.max(0, r.top + window.pageYOffset - off - 10);
    if(Math.abs(window.pageYOffset - y) < 10) return;
    window.scrollTo({ top:y, behavior: MOTION_OK ? 'smooth' : 'auto' });
  }

  var _willChangeTimer = null;
  var _hasNavigated    = false;

  function goToStep(i){
    state.step = Math.max(0, Math.min(STEP_COUNT - 1, i));

    track.style.willChange = 'transform';
    track.style.transform  = 'translateX(-' + (state.step * 100) + '%)';
    clearTimeout(_willChangeTimer);
    _willChangeTimer = setTimeout(function(){ track.style.willChange = 'auto'; }, 500);

    pfRoot.classList.toggle('is-done', state.step === STEP_COUNT - 1);
    renderDots();
    syncNav();
    updateTotalsAndPills();

    /* never on question one — that would jump past the reviews on load */
    if(state.step > 0) scrollToWidgetTop();

    /* focus the heading for screen readers, but not on the first render */
    if(_hasNavigated){
      var newStep = steps[state.step];
      if(newStep){
        var heading = newStep.querySelector('h3');
        if(heading){
          heading.setAttribute('tabindex','-1');
          try{ heading.focus({ preventScroll:true }); }catch(e){}
        }
      }
    }
    _hasNavigated = true;
  }

  function setSelected(group, value, optEl){
    state[group] = value;

    if(group === 'vehicle'){
      state.smell = null;
      state.service = null;
      clearStepSelection(1);
      clearStepSelection(2);
    }
    if(group === 'smell'){
      state.service = null;
      clearStepSelection(2);
    }

    var stepIndex = Number(optEl.closest('.step').getAttribute('data-step'));
    clearStepSelection(stepIndex);
    optEl.setAttribute('aria-selected','true');

    updateTotalsAndPills();

    if(state.step < STEP_COUNT - 1) goToStep(state.step + 1);
  }

  function onOptionActivate(optEl){
    var group = optEl.getAttribute('data-pick');
    var value = optEl.getAttribute('data-value');
    if(group === 'service' && value === 'optionB' && state.smell !== 'cigarette') return;
    setSelected(group, value, optEl);
  }

  pfRoot.querySelectorAll('.opt[role="option"]').forEach(function(opt){
    opt.addEventListener('click', function(){ onOptionActivate(opt); });
    opt.addEventListener('keydown', function(e){
      if(e.key === 'Enter' || e.key === ' '){ e.preventDefault(); onOptionActivate(opt); }
    });
  });

  var learnMoreBtn = document.getElementById('odrLearnMoreBtn');
  if(learnMoreBtn){
    learnMoreBtn.addEventListener('click', function(){
      var el = document.getElementById('learnMoreOdourRemoval');
      if(el) el.scrollIntoView({ behavior:'smooth', block:'start' });
    });
  }

  btnBack.addEventListener('click', function(){
    if(state.step > 0) goToStep(state.step - 1);
  });

  btnNext.addEventListener('click', function(){
    if(isAnswered(state.step) && state.step < STEP_COUNT - 1) goToStep(state.step + 1);
  });

  resetBtn.addEventListener('click', function(){
    Object.assign(state, { step:0, vehicle:null, smell:null, service:null });
    clearAllSelections();
    optionBCard.style.display = '';
    goToStep(0);
  });

  doneBtn.addEventListener('click', function(){
    var price             = getPrice();
    var url               = buildAcuityUrl();
    var appointmentTypeId = getAppointmentTypeId();

    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({
      event:           'pf_book_click',
      component:       'price_finder',
      service:         'smoke_milk_bio_odour_removal',
      vehicle_type:    state.vehicle || null,
      odour_type:      state.smell   || null,
      odour_option:    state.service || null,
      price_total:     price || null,
      acuity_type_id:  appointmentTypeId,
      acuity_key:      getAcuityKey(),
      gclid:           getGclid(),
      destination_url: url
    });

    window.location.href = url;
  });

  buildDots();
  goToStep(0);

  /* =====================================================================
     SIZE HANDED OVER FROM THE HOMEPAGE ROUTER
     The router sends ?size=small|medium|large. We map it to this
     questionnaire's own vehicle values, select it, and let the normal flow
     open question 2 — so nobody answers the same thing twice.
     ===================================================================== */
  (function prefillFromRouter(){
    var MAP = { small:'3door', medium:'5door', large:'7seater' };
    var want;
    try{ want = new URLSearchParams(window.location.search).get('size'); }catch(e){ return; }
    if(!want) return;

    var value = MAP[String(want).trim().toLowerCase()];
    if(!value) return;

    var el = document.querySelector(
      '#priceFinderOdourRemoval .opt[data-pick="vehicle"][data-value="' + value + '"]'
    );
    if(!el) return;

    setTimeout(function(){ el.click(); }, 0);
  })();

  /* =====================================================================
     Landing position — the reviews badge loads late, so the page can settle
     part-way down. Put it back at the top, but only if the person hasn't
     touched anything and there's no #hash to honour.
     ===================================================================== */
  var _touched = false;
  ['touchstart','wheel','keydown','pointerdown','mousedown'].forEach(function(ev){
    window.addEventListener(ev, function(){ _touched = true; }, { once:true, passive:true });
  });

  function settleAtTop(){
    if(_touched) return;
    if(window.location.hash) return;
    if(window.pageYOffset <= 4) return;
    window.scrollTo(0, 0);
  }

  window.addEventListener('load', settleAtTop);
  setTimeout(settleAtTop, 250);
  setTimeout(settleAtTop, 700);
})();
</script>
