<!-- MobilePitStop — Maintenance Plan: booking questionnaire -->
<!-- For https://mobilepitstop.uk/car-valeting-maintenance-plan
     ==========================================================================
     HOW THE PLAN WORKS
       1. Customer books a Full Valet (the reset).
       2. After it, you agree a frequency together.
       3. They get a discount code and book Mini Valets with it.

     So this page needs NO new Acuity appointment types. The CTA sends them to
     the existing Full Valet booking; the discount code does the rest.

     TIERS CAP AT 6 WEEKS — deliberately.
     Beyond that a car needs an interior deep clean and stains work, so a
     discounted Mini Valet would be the wrong service. Those customers are
     routed to the Interior Deep Clean instead: better result, and worth more.

     TUNING
     Everything commercial lives in PLAN_CONFIG below — sizes, tiers,
     percentages and add-ons. Change a number there and the whole page follows.
     ========================================================================== -->
<meta name="viewport" content="width=device-width, initial-scale=1">

<script>
  (function(){
    try{ if('scrollRestoration' in history) history.scrollRestoration = 'manual'; }catch(e){}
  })();
</script>

<style>
  :root{
    --bg:#0b0b0b; --card:#121212; --muted:#1b1b1b; --text:#fff;
    --accent:#E3FC02; --accent-ink:#0b0b0b; --ocean:#00B8FF;
    --radius:16px; --border:rgba(255,255,255,.12);
  }
  *{ box-sizing:border-box; }

  .pf{
    max-width:900px; margin:0 auto; padding:24px; color:var(--text);
    font-family:system-ui,-apple-system,Segoe UI,Roboto,Inter,Arial,sans-serif;
    background:linear-gradient(180deg,rgba(255,255,255,.05),rgba(255,255,255,.02));
    border:1px solid rgba(255,255,255,.08); border-radius:var(--radius); overflow:hidden;
  }

  .topbar{ display:flex; align-items:flex-start; justify-content:space-between; gap:14px; margin-bottom:8px; }
  .topbar h1{ margin:0; font-size:clamp(20px,3vw,26px); font-weight:950; letter-spacing:.2px; }
  .topbar h3{ margin:6px 0 0; font-size:16px; font-weight:900; opacity:.9; }
  .lead{ margin:6px 0 14px; color:#d0d0d0; font-size:14px; }

  .totalbox{
    min-width:220px; border:1px solid rgba(255,255,255,.14); background:rgba(0,0,0,.22);
    border-radius:14px; padding:12px; text-align:right; flex-shrink:0;
  }
  .totalbox .lbl{ font-size:12px; color:#cfcfcf; }
  .totalbox .val{ font-size:26px; font-weight:950; color:var(--accent); margin-top:2px; }
  .totalbox .note{ font-size:12px; color:#bdbdbd; margin-top:4px; line-height:1.35; }
  .pf.is-done .topbar .totalbox{ display:none; }

  @media(max-width:720px){
    .topbar{ flex-direction:column; }
    .totalbox{ width:100%; text-align:left; min-width:0; }
  }

  /* how it works strip */
  .howto{
    margin:0 0 16px; padding:14px; border-radius:14px;
    border:1px solid rgba(227,252,2,.3); background:rgba(227,252,2,.05);
  }
  .howto-title{
    font-size:11px; text-transform:uppercase; letter-spacing:.14em;
    font-weight:950; color:var(--accent); margin:0 0 10px;
  }
  .howto-steps{ display:grid; gap:10px; grid-template-columns:1fr; }
  @media(min-width:640px){ .howto-steps{ grid-template-columns:repeat(3,1fr); } }
  .howto-step{ display:flex; align-items:flex-start; gap:10px; font-size:13px; line-height:1.45; }
  .howto-num{
    width:26px; height:26px; border-radius:50%; background:var(--accent);
    color:var(--accent-ink); font-weight:950; font-size:13px;
    display:flex; align-items:center; justify-content:center; flex-shrink:0;
  }
  .howto-step strong{ display:block; color:#fff; font-weight:900; font-size:13px; }
  .howto-step span{ color:rgba(255,255,255,.6); font-size:12.5px; }

  /* free perk — the one thing on this page that costs nothing */
  .perk-bar{
    display:flex;
    align-items:center;
    gap:12px;
    margin:0 0 16px;
    padding:12px 14px;
    border-radius:12px;
    border:1px solid rgba(0,184,255,.42);
    background:rgba(0,184,255,.08);
  }
  .perk-flag{
    flex:0 0 auto;
    font-size:11px;
    font-weight:900;
    letter-spacing:.06em;
    text-transform:uppercase;
    padding:5px 11px;
    border-radius:999px;
    background:var(--ocean);
    color:#00131c;
    white-space:nowrap;
  }
  .perk-text{ font-size:13px; line-height:1.45; color:#d8d8d8; }
  .perk-text strong{ color:var(--ocean); font-weight:900; }
  @media(max-width:560px){
    .perk-bar{ flex-direction:column; align-items:flex-start; gap:8px; }
  }

  /* chip on each frequency card */
  .prem-perk{
    display:inline-flex;
    align-items:center;
    gap:6px;
    margin:8px 0 0 6px;
    font-size:12px;
    font-weight:900;
    padding:4px 10px;
    border-radius:999px;
    white-space:nowrap;
    color:var(--ocean);
    border:1px solid rgba(0,184,255,.35);
    background:rgba(0,184,255,.08);
  }

  .info-bar{
    margin:0 0 16px; padding:10px 14px; border-radius:12px;
    border:1px solid rgba(255,255,255,.18); background:rgba(0,0,0,.28);
    font-size:13px; line-height:1.45; color:#d0d0d0;
  }
  .info-bar strong{ color:#fff; font-weight:900; }
  .info-bar a{ color:var(--accent); font-weight:900; text-decoration:none; white-space:nowrap; }
  .info-bar a:hover{ text-decoration:underline; }


  /* ── Remove control on each add-on line ───────────────────────
     With "Start again" gone, this is how someone drops an extra from
     "your plan, this visit" without stepping back through the questions.
     ─────────────────────────────────────────────────────────── */
  .bd-row.bd-removable{ align-items:center; }
  .bd-amt-wrap{ display:flex; align-items:center; gap:9px; flex:0 0 auto; }
  .bd-remove{
    appearance:none; border:1px solid rgba(255,255,255,.2); background:transparent;
    color:rgba(255,255,255,.5); width:22px; height:22px; border-radius:50%;
    font-size:14px; line-height:1; font-family:inherit; cursor:pointer;
    display:inline-flex; align-items:center; justify-content:center;
    padding:0; flex:0 0 22px;
    transition:border-color .15s ease, color .15s ease, background .15s ease;
  }
  .bd-remove:hover, .bd-remove:focus-visible{
    border-color:#FF6B5A; color:#FF6B5A; background:rgba(255,107,90,.1); outline:none;
  }
  @media(max-width:420px){
    .bd-remove{ width:26px; height:26px; flex-basis:26px; font-size:15px; }
  }

  /* ── Progress bar ─────────────────────────────────────────── */
  .prog{ margin:0 0 14px; }
  .prog-top{ display:flex; align-items:baseline; justify-content:space-between; gap:10px; margin-bottom:7px; }
  .prog-step{ font-size:11px; font-weight:900; letter-spacing:.12em; text-transform:uppercase; color:rgba(255,255,255,.5); }
  .prog-label{ font-size:12px; font-weight:800; color:var(--accent); text-align:right; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; max-width:62%; }
  .prog-track{ display:flex; gap:5px; }
  .prog-seg{ flex:1; height:4px; border-radius:99px; background:rgba(255,255,255,.12); transition:background .35s ease, box-shadow .35s ease; }
  .prog-seg.done{ background:rgba(227,252,2,.45); }
  .prog-seg.now{ background:var(--accent); box-shadow:0 0 10px rgba(227,252,2,.45); }

  /* nav hidden on question one — both buttons are dead there */
  .pf.is-first .nav{ display:none; }

  /* ── Plan activation, the Done step ───────────────────────────
     This page gets sent to customers directly, so the last step has to
     close rather than just inform. Two routes out:
       • no plan yet  -> Start with a Full Valet
       • already have a code -> Start My Plan -> enter code -> book
     The calendar button stays dead until a real plan code is entered,
     so nobody books a plan rate they aren't entitled to.
     ─────────────────────────────────────────────────────────── */
  .plan-cta{ display:grid; gap:10px; margin-top:14px; }
  @media(min-width:640px){ .plan-cta{ grid-template-columns:1fr 1fr; } }

  .pf .btn-plan{
    display:inline-flex; align-items:center; justify-content:center;
    width:100%; padding:13px 16px; border-radius:999px;
    border:1px solid var(--ocean); background:transparent; color:#fff;
    font-weight:900; font-size:14.5px; font-family:inherit; cursor:pointer;
    transition:background .15s ease, box-shadow .15s ease, transform .15s ease;
  }
  .pf .btn-plan:hover, .pf .btn-plan:focus-visible{
    background:rgba(0,184,255,.12); box-shadow:0 6px 18px rgba(0,184,255,.16);
    transform:translateY(-1px); outline:none;
  }
  .pf .btn-plan.is-open{ background:rgba(0,184,255,.14); border-color:var(--ocean); }

  .plan-code{
    margin-top:12px; padding:15px;
    border-radius:14px; border:1px solid rgba(0,184,255,.4);
    background:rgba(0,184,255,.06);
  }
  .plan-code[hidden]{ display:none; }
  .plan-code h4{
    margin:0 0 4px; font-size:14.5px; font-weight:950; color:#fff;
  }
  .plan-code p{ margin:0 0 11px; font-size:13px; line-height:1.5; color:rgba(255,255,255,.78); }
  .plan-code-row{ display:flex; gap:9px; flex-wrap:wrap; }
  .plan-code-row input{
    flex:1 1 170px; min-width:0;
    padding:12px 14px; border-radius:12px;
    border:1px solid rgba(255,255,255,.22);
    background:#111; color:#fff;
    font-family:inherit; font-size:15px; font-weight:800;
    letter-spacing:.06em; text-transform:uppercase;
  }
  .plan-code-row input:focus{
    outline:none; border-color:var(--ocean);
    box-shadow:0 0 0 3px rgba(0,184,255,.14);
  }
  .plan-code-row button{
    flex:0 0 auto; padding:12px 20px; border-radius:12px;
    border:none; background:var(--ocean); color:#00131c;
    font-family:inherit; font-weight:950; font-size:14.5px; cursor:pointer;
  }
  .plan-code-msg{ margin-top:9px; font-size:13px; font-weight:800; min-height:18px; }
  .plan-code-msg.bad{ color:#FF6B5A; }
  .plan-code-msg.good{ color:#4ADE80; }

  /* the calendar button: dead until a valid plan code is entered */
  .pf .btn-cal{
    display:inline-flex; align-items:center; justify-content:center;
    width:100%; margin-top:12px; padding:14px 18px; border-radius:999px;
    border:none; font-family:inherit; font-weight:950; font-size:15px;
    background:rgba(255,255,255,.09); color:rgba(255,255,255,.38);
    cursor:not-allowed; text-decoration:none;
    transition:background .2s ease, color .2s ease, box-shadow .2s ease, transform .15s ease;
  }
  .pf .btn-cal.is-live{
    background:linear-gradient(135deg,#E3FC02 0%,#d6ff6b 100%);
    color:var(--accent-ink);
    cursor:pointer;
    box-shadow:0 8px 22px rgba(227,252,2,.28);
  }
  .pf .btn-cal.is-live:hover{ transform:translateY(-1px); box-shadow:0 12px 28px rgba(227,252,2,.38); }

  @media(max-width:420px){
    .prog-label{ font-size:11.5px; max-width:56%; }
    .prog-seg{ height:5px; }
    .plan-code{ padding:13px 12px; }
    .plan-code-row button{ flex:1 1 100%; }
  }

  .wizard{ background:var(--card); border:1px solid rgba(255,255,255,.08); border-radius:14px; overflow:hidden; }
  .viewport{ overflow:hidden; border-radius:14px; width:100%; }
  .viewport.is-ready{ transition:height .35s ease; }
  .track{ display:flex; width:100%; align-items:flex-start; transition:transform .45s ease; }
  .step{ flex:0 0 100%; padding:18px; min-width:100%; }
  .step h3{ font-size:clamp(18px,2.4vw,22px); line-height:1.25; margin:0 0 12px; font-weight:950; letter-spacing:-.01em; }
  .step-note{ margin:-4px 0 12px; font-size:12.5px; color:rgba(255,255,255,.55); line-height:1.5; }

  .opts{ display:flex; flex-direction:column; gap:10px; }
  .opt{
    border:1px solid rgba(255,255,255,.15); border-radius:12px; padding:14px;
    background:var(--muted); cursor:pointer; position:relative; width:100%;
    transition:transform .15s ease, border-color .15s ease, background .15s ease;
  }
  .opt:hover{ border-color:var(--accent); transform:translateY(-1px); }
  .opt[aria-selected="true"]{ border-color:rgba(227,252,2,.9); background:rgba(227,252,2,.08); }

  .opt .row{ display:flex; align-items:flex-start; justify-content:space-between; gap:10px; font-weight:950; flex-wrap:wrap; }
  .opt .row span:first-child{ flex:1 1 auto; min-width:0; overflow-wrap:anywhere; }

  .price-pill{
    display:inline-flex; align-items:center; justify-content:center; font-weight:950;
    color:var(--accent); border:1px solid rgba(227,252,2,.5); background:rgba(227,252,2,.12);
    padding:4px 10px; border-radius:999px; white-space:nowrap; flex:0 0 auto;
  }

  .opt-premium{
    padding:16px; border-radius:14px; border:1px solid rgba(255,255,255,.10);
    background:linear-gradient(180deg,rgba(255,255,255,.045),rgba(255,255,255,.02));
    box-shadow:0 14px 40px rgba(0,0,0,.55);
  }
  .opt[aria-selected="true"].opt-premium{
    border-color:rgba(227,252,2,.28);
    background:linear-gradient(180deg,rgba(227,252,2,.085),rgba(255,255,255,.02));
  }
  .prem-head{ display:flex; align-items:flex-start; justify-content:space-between; gap:12px; flex-wrap:wrap; }
  .prem-head > div:first-child{ flex:1 1 auto; min-width:0; }
  .prem-kicker{ font-size:12px; color:rgba(255,255,255,.72); margin-bottom:2px; }
  .prem-name{ font-size:16px; font-weight:950; letter-spacing:-.01em; overflow-wrap:anywhere; }
  /* Price pill, pinned top-right at every width. */
  .opt-premium{ position:relative; }
  .prem-price{
    position:absolute; top:14px; right:14px; z-index:2;
    font-size:13px; font-weight:950; color:var(--accent);
    border:1px solid rgba(227,252,2,.32); background:rgba(227,252,2,.08);
    padding:6px 10px; border-radius:999px; white-space:nowrap; line-height:1; margin:0;
  }
  .prem-name{ padding-right:86px; }
  .prem-kicker{ padding-right:86px; }
  .prem-price .was{ color:rgba(255,255,255,.42); text-decoration:line-through; margin-right:7px; }
  .prem-desc{ margin-top:10px; font-size:13px; line-height:1.5; color:rgba(255,255,255,.72); overflow-wrap:anywhere; }

  .prem-save{
    display:inline-flex; align-items:center; margin-top:8px;
    font-size:12px; font-weight:900; padding:4px 10px; border-radius:999px;
    white-space:nowrap; color:var(--accent-ink); background:var(--accent);
  }
  .prem-note{
    display:inline-flex; align-items:center; margin-top:8px;
    font-size:12px; font-weight:900; padding:4px 10px; border-radius:999px;
    white-space:nowrap; color:var(--ocean);
    border:1px solid rgba(0,184,255,.3); background:rgba(0,184,255,.07);
  }

  /* summary */
  .summary{ margin-top:14px; background:rgba(0,0,0,.18); border:1px solid rgba(255,255,255,.12); border-radius:14px; padding:14px; }
  .pills{ display:flex; flex-wrap:wrap; gap:6px; }
  .pill{ display:inline-block; border:1px solid rgba(255,255,255,.2); padding:6px 10px; border-radius:999px; color:#ddd; font-size:13px; overflow-wrap:anywhere; }
  .pill strong{ color:#fff; }

  .bd{ margin-top:14px; padding-top:14px; border-top:1px solid rgba(255,255,255,.12); }
  .bd-title{
    display:flex; align-items:center; gap:7px; font-size:11px; text-transform:uppercase;
    letter-spacing:.12em; font-weight:900; margin-bottom:6px; color:var(--accent);
  }
  .bd-row{
    display:flex; align-items:baseline; justify-content:space-between; gap:12px;
    padding:7px 0; border-top:1px solid rgba(255,255,255,.06); font-size:13px; font-weight:900;
  }
  .bd-row:first-of-type{ border-top:none; }
  .bd-nm{ color:rgba(255,255,255,.86); flex:1 1 auto; min-width:0; overflow-wrap:anywhere; }
  .bd-amt{ flex:0 0 auto; white-space:nowrap; color:var(--accent); }
  .bd-row.bd-free .bd-amt{ color:var(--ocean); }
  .bd-row.bd-off .bd-amt{ color:var(--ocean); }
  .bd-sub{ font-size:12px; font-weight:400; color:rgba(255,255,255,.55); margin-top:2px; line-height:1.4; }
  .bd-total{
    display:flex; align-items:baseline; justify-content:space-between; gap:12px;
    margin-top:14px; padding-top:12px; border-top:1px solid rgba(255,255,255,.16);
  }
  .bd-total .bd-nm{ font-size:12px; text-transform:uppercase; letter-spacing:.12em; font-weight:900; color:rgba(255,255,255,.72); }
  .bd-total .bd-amt{ font-size:22px; font-weight:950; }

  /* routed-away panel for infrequent visits */
  .reroute{
    margin-top:14px; padding:14px; border-radius:14px;
    border:1px solid rgba(0,184,255,.35); background:rgba(0,184,255,.06);
    font-size:13px; line-height:1.55; color:#d5d5d5;
  }
  .reroute h4{ margin:0 0 6px; font-size:15px; font-weight:950; color:var(--ocean); }
  .reroute a{ color:var(--ocean); font-weight:900; }

  .nav{
    display:flex; align-items:center; justify-content:flex-start; gap:10px;
    padding:12px 14px; border-top:1px solid rgba(255,255,255,.08);
    background:rgba(0,0,0,.18); border-radius:0 0 14px 14px;
  }
  .btn{
    appearance:none; border:1px solid rgba(255,255,255,.25); background:transparent; color:#fff;
    border-radius:999px; padding:10px 14px; font-weight:900; cursor:pointer;
    transition:transform .15s ease, border-color .15s ease, box-shadow .15s ease, filter .15s ease;
  }
  .btn:hover{ transform:translateY(-1px); border-color:var(--accent); box-shadow:0 8px 18px rgba(227,252,2,.10); }
  .btn:disabled{ opacity:.45; cursor:not-allowed; transform:none; box-shadow:none; }
  .btn-primary-glow{
    border:none; background:linear-gradient(135deg,#E3FC02 0%,#d6ff6b 100%);
    color:var(--accent-ink); box-shadow:0 8px 20px rgba(227,252,2,.25); padding:12px 16px;
  }
  .btn-primary-glow:hover{ box-shadow:0 12px 28px rgba(227,252,2,.35),0 0 20px rgba(227,252,2,.2); filter:saturate(1.05); }

  .dots{ display:flex; gap:6px; align-items:center; justify-content:center; flex:1; }
  .dot{ width:8px; height:8px; border-radius:99px; background:rgba(255,255,255,.25); }
  .dot.on{ background:var(--accent); }

  /* ===== MOBILE ===== */
  @media(max-width:640px){
    .pf{ padding:16px 14px; border-radius:12px; }
    .step{ padding:14px 12px; }
    .topbar{ gap:10px; margin-bottom:6px; }
    .topbar h1{ font-size:20px; line-height:1.2; }
    .topbar h3{ font-size:14px; margin-top:4px; }
    .lead{ font-size:13px; margin:4px 0 10px; }
    /* Total box — grid, not flex, so label and price never wrap. */
    .totalbox{
      display:grid; grid-template-columns:auto 1fr; align-items:baseline;
      column-gap:12px; row-gap:3px; padding:11px 13px; text-align:left;
    }
    .totalbox .lbl{ font-size:11.5px; white-space:nowrap; letter-spacing:.02em; }
    .totalbox .val{ font-size:23px; margin-top:0; text-align:right; white-space:nowrap; line-height:1.1; }
    .totalbox .was{ grid-column:2; text-align:right; font-size:13px; margin-top:0; }
    .totalbox .note{ grid-column:1 / -1; margin-top:1px; font-size:11.5px; line-height:1.35; color:#b8b8b8; }
    .info-bar{ font-size:12px; padding:9px 12px; margin-bottom:12px; }
    .howto{ padding:12px; }
    .opt{ padding:13px 12px; }
    .opt-premium{ padding:13px 12px; box-shadow:0 8px 20px rgba(0,0,0,.4); }
    .prem-name{ font-size:15px; }
    .prem-desc{ font-size:12.5px; margin-top:8px; }
    .prem-head{ gap:8px; }
    .nav{ padding:10px 12px; gap:8px; }
    .btn{ padding:12px 14px; font-size:14px; min-height:46px; }
    .summary{ padding:12px; }
    .pill{ font-size:12px; padding:5px 9px; }
    .bd-row{ font-size:12.5px; }
    .bd-total .bd-amt{ font-size:20px; }
  }
  @media(max-width:380px){
    .topbar h1{ font-size:18px; }
    .totalbox .val{ font-size:20px; }
    .btn{ padding:11px 12px; font-size:13.5px; }
  }
</style>

