<div class="pf" id="priceFinderMaintenancePlan">

  <div class="topbar">
    <div>
      <h1>Detailing Maintenance Plan</h1>
      <h3>Up to 30% off every visit</h3>
    </div>
    <div class="totalbox" aria-live="polite">
      <div class="lbl">Your plan rate</div>
      <div class="val" id="mpTotal">&mdash;</div>
      <div class="note" id="mpNote">Choose your vehicle size</div>
    </div>
  </div>

  <div class="howto">
    <div class="howto-title">How it works</div>
    <div class="howto-steps">
      <div class="howto-step">
        <div class="howto-num">1</div>
        <div><strong>Start with a deep clean</strong></div>
      </div>
