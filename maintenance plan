</div>

<script>
(function(){
  var root = document.getElementById('priceFinderMaintenancePlan');
  if(!root) return;

  /* =====================================================================
     PLAN CONFIG — the only place commercial numbers live.
     Change a price or a percentage here and the whole page follows.
     ===================================================================== */
  var PLAN_CONFIG = {
    /* standard Mini Valet prices */
    vehicle: {
      '3door':  { label:'Small (3-door)',            price:50 },
      '5door':  { label:'Medium (5-door / saloon)',  price:55 },
      '7seats': { label:'Large (SUV / 7 Seater)',    price:60 },
      'quote':  { label:'Van / pickup / camper',     price:null }
    },

    /* discount tiers. Capped at 6 weeks on purpose — past that a Mini
       Valet can't hold a car, so those customers get routed elsewhere. */
    freq: {
      weekly:      { label:'Every week',        off:30 },
      fortnightly: { label:'Every 2-3 weeks',   off:25 },
      monthly:     { label:'Every 4-6 weeks',   off:20 },
      rare:        { label:'Less often',        off:null }   /* routed away */
    },

    /* Per-visit extras. The plan discount applies to these too.
       These are "add to any visit" rather than every visit — most cars
       only need the heavier interior work occasionally. */
    extras: {
      deep:   { label:'Interior deep clean',              price:30 },
      stains: { label:'Seat stain removal',               price:30 },
      full:   { label:'Full interior steam, shampoo & extraction', price:20,
                note:'Upgrade from seats-only' },
      wax:    { label:'Hydrophobic wax',                  price:10 }
    },

    /* included free on every plan visit */
    perk: 'Chemical decontamination'
  };

  var track   = root.querySelector('#mpTrack');
  var btnBack = root.querySelector('#mpBack');
  var btnNext = root.querySelector('#mpNext');   /* removed from the markup */
  var dotsEl  = root.querySelector('#mpDots');

  var totalEl    = root.querySelector('#mpTotal');
  var noteEl     = root.querySelector('#mpNote');
  var finalTotal = root.querySelector('#mpFinalTotal');
  var finalNote  = root.querySelector('#mpFinalNote');
  var pillsEl    = root.querySelector('#mpPills');
  var bdEl       = root.querySelector('#mpBreakdown');

  /* Delegated from the container, because the breakdown re-renders on
     every change — handlers bound to the buttons themselves would be
     thrown away each time. Placed after bdEl is declared, not before:
     a const/var used ahead of its declaration throws and kills the script. */
  if(bdEl){
    bdEl.addEventListener('click', function(e){
      var btn = e.target.closest ? e.target.closest('.bd-remove') : null;
      if(!btn) return;
      var key = btn.getAttribute('data-remove');
      if(['deep','stains','full','wax'].indexOf(key) === -1) return;

      state[key] = 'no';
      /* the interior extras build on each other, so clearing one clears
         everything downstream of it */
      if(key === 'deep'){ state.stains = 'no'; state.full = 'no'; }
      if(key === 'stains'){ state.full = 'no'; }

      var sync = function(k){
        root.querySelectorAll('.opt[data-pick="' + k + '"]').forEach(function(o){
          o.setAttribute('aria-selected', o.getAttribute('data-value') === 'no' ? 'true' : 'false');
        });
      };
      sync(key);
      if(key === 'deep'){ sync('stains'); sync('full'); }
      if(key === 'stains'){ sync('full'); }

      update();
    });
  }

  var rerouteEl  = root.querySelector('#mpReroute');
  var hintEl     = root.querySelector('#mpHint');
  var doneBtn    = root.querySelector('#mpDoneBtn');
  var resetBtn   = root.querySelector('#mpResetBtn');

  var pxWeekly  = root.querySelector('#mpPxWeekly');
  var pxFort    = root.querySelector('#mpPxFort');
  var pxMonthly = root.querySelector('#mpPxMonthly');
  var pxWax     = root.querySelector('#mpPxWax');

  var steps      = Array.prototype.slice.call(track.querySelectorAll('.step'));
  var STEP_COUNT = steps.length;

  var state = { step:0, vehicle:null, freq:null, deep:null, stains:null, full:null, wax:null };

  function fmt(n){ return '\u00a3' + Number(n || 0).toFixed(2).replace(/\.00$/,''); }

  function basePrice(){
    if(!state.vehicle) return null;
    return PLAN_CONFIG.vehicle[state.vehicle].price;   /* null for 'quote' */
  }
  function offPct(){
    if(!state.freq) return null;
    return PLAN_CONFIG.freq[state.freq].off;           /* null for 'rare' */
  }
  function isQuote(){ return state.vehicle === 'quote'; }
  function isRare(){  return state.freq === 'rare'; }

  /* full price before the discount, including any extras chosen */
  function extrasTotal(){
    var E = PLAN_CONFIG.extras, t = 0;
    if(state.deep   === 'yes') t += E.deep.price;
    if(state.stains === 'yes') t += E.stains.price;
    if(state.full   === 'yes') t += E.full.price;
    if(state.wax    === 'yes') t += E.wax.price;
    return t;
  }

  function fullPrice(){
    var b = basePrice();
    if(b === null) return null;
    return b + extrasTotal();
  }

  function planPrice(){
    var f = fullPrice(), o = offPct();
    if(f === null || o === null) return null;
    return f * (1 - o / 100);
  }

  /* ---- live price pills on the frequency cards ---- */
  function updateFreqPills(){
    var b = basePrice();
    var map = { weekly:pxWeekly, fortnightly:pxFort, monthly:pxMonthly };
    Object.keys(map).forEach(function(k){
      var el = map[k];
      if(!el) return;
      if(b === null){ el.textContent = 'By quote'; return; }
      var o = PLAN_CONFIG.freq[k].off;
      el.innerHTML = '<span class="was">' + fmt(b) + '</span>' + fmt(b * (1 - o/100));
    });
    /* extras show their full price struck through, then the plan price */
    var o2 = offPct();
    var pills = {
      deep:   root.querySelector('#mpPxDeep'),
      stains: root.querySelector('#mpPxStains'),
      full:   root.querySelector('#mpPxFull'),
      wax:    root.querySelector('#mpPxWax')
    };
    Object.keys(pills).forEach(function(k){
      var el = pills[k];
      if(!el) return;
      var px = PLAN_CONFIG.extras[k].price;
      if(b === null){ el.textContent = 'By quote'; return; }
      el.innerHTML = (o2 === null || isRare())
        ? '+' + fmt(px)
        : '<span class="was">+' + fmt(px) + '</span>+' + fmt(px * (1 - o2/100));
    });
  }

  /* ---- breakdown ---- */
  function renderBreakdown(){
    if(!bdEl) return;

    if(isRare()){ bdEl.innerHTML = ''; return; }

    if(!state.vehicle || !state.freq){ bdEl.innerHTML = ''; return; }

    if(isQuote()){
      bdEl.innerHTML =
        '<div class="bd-title"><span>&#9733;</span> Your plan</div>' +
        '<div class="bd-row"><div class="bd-nm">' + PLAN_CONFIG.vehicle.quote.label +
          '<div class="bd-sub">We\'ll confirm your base price, then apply the plan discount</div></div>' +
          '<div class="bd-amt">By quote</div></div>' +
        '<div class="bd-row bd-off"><div class="bd-nm">' + PLAN_CONFIG.freq[state.freq].label + '</div>' +
          '<div class="bd-amt">&minus;' + offPct() + '%</div></div>' +
        '<div class="bd-row bd-free"><div class="bd-nm">' + PLAN_CONFIG.perk + '</div>' +
          '<div class="bd-amt">Free</div></div>';
      return;
    }

    var b = basePrice();
    var o = offPct();
    var full = fullPrice();
    var plan = planPrice();

    var html = '<div class="bd-title"><span>&#9733;</span> Your plan, this visit</div>';

    html += '<div class="bd-row"><div class="bd-nm">Mini Valet &mdash; ' +
            PLAN_CONFIG.vehicle[state.vehicle].label +
            '</div><div class="bd-amt">' + fmt(b) + '</div></div>';

    var E = PLAN_CONFIG.extras;
    ['deep','stains','full','wax'].forEach(function(k){
      if(state[k] !== 'yes') return;
      html += '<div class="bd-row bd-removable"><div class="bd-nm">' + E[k].label +
              (E[k].note ? '<div class="bd-sub">' + E[k].note + '</div>' : '') +
              '</div><div class="bd-amt-wrap">' +
                '<span class="bd-amt">+' + fmt(E[k].price) + '</span>' +
                '<button class="bd-remove" type="button" data-remove="' + k +
                  '" aria-label="Remove ' + E[k].label + '" title="Remove">&times;</button>' +
              '</div></div>';
    });

    html += '<div class="bd-row bd-off"><div class="bd-nm">Plan discount' +
            '<div class="bd-sub">' + PLAN_CONFIG.freq[state.freq].label + '</div></div>' +
            '<div class="bd-amt">&minus;' + fmt(full - plan) + '</div></div>';

    html += '<div class="bd-row bd-free"><div class="bd-nm">' + PLAN_CONFIG.perk +
            '<div class="bd-sub">Iron fallout and road film off the wheels and paint &mdash; ' +
            'a paid extra on a one-off booking, free on the plan</div></div>' +
            '<div class="bd-amt">Free</div></div>';

    html += '<div class="bd-total"><div class="bd-nm">This visit</div>' +
            '<div class="bd-amt">' + fmt(plan) + '</div></div>';

    bdEl.innerHTML = html;
  }

  /* ---- the "less often" route ---- */
  function renderReroute(){
    if(!rerouteEl) return;
    if(!isRare()){ rerouteEl.innerHTML = ''; return; }
    rerouteEl.innerHTML =
      '<div class="reroute">' +
      '<h4>A Mini Valet isn\'t the right service for you</h4>' +
      '<p>Left longer than six weeks, the inside of a car needs more than a tidy-up &mdash; ' +
      'carpets and seats pick up staining that a maintenance clean won\'t lift. We could sell you ' +
      'a discounted Mini Valet, but you\'d be disappointed with it, so we won\'t.</p>' +
      '<p style="margin-top:8px"><strong>What we\'d suggest instead:</strong> an ' +
      '<a href="https://mobilepitstop.uk/interior-deep-clean">Interior Deep Clean</a> ' +
      'or a <a href="https://mobilepitstop.uk/full-valet">Full Valet</a> whenever the car needs it. ' +
      'Book it as often or as rarely as you like &mdash; no plan required.</p>' +
      '<p style="margin-top:8px">Not sure which? Call or message us on ' +
      '<a href="tel:07592196929">07592 196929</a> and we\'ll tell you straight.</p>' +
      '</div>';
  }

  function update(){
    updateFreqPills();

    var plan = planPrice();
    var shown = isRare() ? '\u2014'
              : isQuote() && state.freq ? 'By quote'
              : plan === null ? '\u2014' : fmt(plan);

    totalEl.textContent    = shown;
    finalTotal.textContent = shown;

    noteEl.textContent = !state.vehicle ? 'Choose your vehicle size'
                       : !state.freq    ? 'Choose how often'
                       : isRare()       ? 'See our suggestion below'
                       : 'Free chemical decontamination included';

    finalNote.textContent = isRare()
      ? 'We\u2019d rather point you at the right service.'
      : 'Includes free chemical decontamination, every visit.';

    /* pills */
    var pills = [];
    if(state.vehicle) pills.push('<span class="pill"><strong>Vehicle:</strong> ' + PLAN_CONFIG.vehicle[state.vehicle].label + '</span>');
    if(state.freq && !isRare()){
      pills.push('<span class="pill"><strong>Frequency:</strong> ' + PLAN_CONFIG.freq[state.freq].label + '</span>');
      pills.push('<span class="pill"><strong>Discount:</strong> ' + offPct() + '% off every visit</span>');
      pills.push('<span class="pill" style="border-color:rgba(0,184,255,.5);color:#cfefff">' +
                 '<strong style="color:#00B8FF">Free:</strong> ' + PLAN_CONFIG.perk + ' every visit</span>');
    }
    var EL = PLAN_CONFIG.extras;
    ['deep','stains','full','wax'].forEach(function(k){
      if(state[k] === 'yes') pills.push('<span class="pill"><strong>Added:</strong> ' + EL[k].label + '</span>');
    });
    if(pillsEl) pillsEl.innerHTML = pills.length ? pills.join('')
      : '<span class="pill"><strong>Ready:</strong> Choose your options above</span>';

    renderBreakdown();
    renderReroute();

    /* CTA + closing note */
    if(isRare()){
      doneBtn.textContent = 'See Interior Deep Clean';
      doneBtn.setAttribute('href', 'https://mobilepitstop.uk/interior-deep-clean');
      hintEl.innerHTML = '';
    } else {
      doneBtn.textContent = 'Start with a Full Valet';
      doneBtn.setAttribute('href', 'https://mobilepitstop.uk/full-valet');
      hintEl.innerHTML =
        '<strong style="color:#fff">What happens next:</strong> book your Full Valet above. ' +
        'Once it\u2019s done and we\u2019ve agreed your frequency, we\u2019ll give you a discount code ' +
        'to use on every Mini Valet booking from then on. ' +
        'No contract and no direct debit \u2014 change or stop whenever you like.' +
        '<br><br><strong style="color:#fff">On extras:</strong> anything above is added to a visit ' +
        'only when the car needs it, at your plan rate. Most people on a regular plan need them ' +
        'a couple of times a year rather than every time.';
    }

    syncViewportHeight();
  }

  /* ---- layout helpers ---- */
  var viewportEl = root.querySelector('.viewport');

  function syncViewportHeight(){
    if(!viewportEl) return;
    var active = steps[state.step];
    if(!active) return;
    var h = active.offsetHeight;
    if(!h) return;
    viewportEl.style.height = h + 'px';
    if(!viewportEl.classList.contains('is-ready')){
      requestAnimationFrame(function(){ viewportEl.classList.add('is-ready'); });
    }
  }

  var MOTION_OK = !(window.matchMedia &&
                    window.matchMedia('(prefers-reduced-motion: reduce)').matches);

  function headerOffset(){
    var tallest = 0;
    var nodes = document.querySelectorAll('header, .Header, #header, .sqs-announcement-bar-dropzone');
    for(var i = 0; i < nodes.length; i++){
      var el = nodes[i], cs = window.getComputedStyle(el);
      if(cs.position !== 'fixed' && cs.position !== 'sticky') continue;
      var r = el.getBoundingClientRect();
      if(r.top <= 4 && r.height > 0) tallest = Math.max(tallest, r.height);
    }
    return tallest ? tallest + 12 : 16;
  }

  /* =====================================================================
     Scrolling — almost never happens now.

     There's no car visual on this page, so the whole block fits on a
     phone screen. Scrolling on every answer just yanked the page and
     pushed the running total out of view.

     Only fires if the question isn't visible at all: the block has been
     scrolled off the top, or sits entirely below the fold. In normal use,
     answering a question moves nothing.
     ===================================================================== */
  function scrollToWidgetTop(){
    var anchor = root.querySelector('.wizard') || root;
    var off = headerOffset();
    var r   = anchor.getBoundingClientRect();
    var vh  = window.innerHeight || document.documentElement.clientHeight;

    var hiddenAbove = r.bottom < off + 40;   /* scrolled past it */
    var hiddenBelow = r.top    > vh - 80;    /* not reached it yet */
    if(!hiddenAbove && !hiddenBelow) return; /* visible — leave the page alone */

    var y = Math.max(0, r.top + window.pageYOffset - off - 10);
    if(Math.abs(window.pageYOffset - y) < 10) return;
    window.scrollTo({ top:y, behavior: MOTION_OK ? 'smooth' : 'auto' });
  }

  if(window.ResizeObserver){
    var ro = new ResizeObserver(function(){ syncViewportHeight(); });
    steps.forEach(function(s){ ro.observe(s); });
  } else {
    window.addEventListener('resize', syncViewportHeight);
  }

  /* ---- nav ---- */
  var _dots = null, _hasNavigated = false, _wc = null;

  function buildDots(){
    if(!dotsEl) return;
    dotsEl.innerHTML = ''; _dots = [];
    for(var i = 0; i < STEP_COUNT; i++){
      var d = document.createElement('span');
      d.className = 'dot';
      dotsEl.appendChild(d); _dots.push(d);
    }
  }

  /* ---- Progress bar ------------------------------------------------- */
  var PROG_LABELS = ['Your vehicle','How often','Interior','Seat stains','Full interior','Wax','Done'];

  var progTrack = root.querySelector('#mpProgTrack');
  var progStep  = root.querySelector('#mpProgStep');
  var progLabel = root.querySelector('#mpProgLabel');

  function buildProg(){
    if(!progTrack || progTrack.children.length) return;
    for(var i = 0; i < STEP_COUNT; i++){
      var d = document.createElement('span');
      d.className = 'prog-seg';
      progTrack.appendChild(d);
    }
  }


  /* =====================================================================
     PLAN ACTIVATION — the Done step

     This page gets sent to customers directly, so the last step has to
     close rather than just inform. Two routes:

       No plan yet   -> "Start with a Full Valet" (the reset comes first)
       Already on it -> "Start My Plan" -> enter code -> calendar unlocks

     The calendar button is deliberately dead until a valid plan code is
     entered. Without that, anyone could book a Mini Valet at plan rates
     without being on the plan.

     ONLY the CLEAN codes work here. AUTUMN20 is a seasonal offer, not a
     plan tier — it doesn't include the free decontamination and it isn't
     tied to a booking frequency, so it has no business unlocking this.
     ===================================================================== */
  /* Each code IS a frequency tier — they aren't independent. freq ties the
     code back to the question 2 answer so the page and Acuity can't show
     different totals. */
  var PLAN_CODES = {
    CLEAN30: { off:30, label:'weekly',           freq:'weekly'      },
    CLEAN25: { off:25, label:'every 2-3 weeks',  freq:'fortnightly' },
    CLEAN20: { off:20, label:'every 4-6 weeks',  freq:'monthly'     }
  };

  /* Mini Valet appointment types — the plan books against these, because a
     plan visit IS a Mini Valet. Keys mirror the Mini Valet questionnaire. */
  var MINI_ACUITY = {
    small:  { base:86209466, wax:87528344, deep:87528388, deep_wax:87528373,
              deep_stains:88343824, deep_stains_wax:88344179,
              deep_extract:88343876, deep_extract_wax:88343901 },
    medium: { base:87527804, wax:87528399, deep:87528407, deep_wax:87528416,
              deep_stains:88344908, deep_stains_wax:88344984,
              deep_extract:88344947, deep_extract_wax:88345016 },
    large:  { base:87527815, wax:87528433, deep:87528439, deep_wax:87528452,
              deep_stains:88345286, deep_stains_wax:88345338,
              deep_extract:88345300, deep_extract_wax:88345410 }
  };

  /* this page sizes 3door/5door/7seats; the Mini Valet uses small/medium/large */
  var SIZE_MAP = { '3door':'small', '5door':'medium', '7seats':'large' };

  var ACUITY_BASE  = 'https://mobilepitstop.as.me/';
  var ACUITY_QUOTE = 84640446;

  var planBtn   = root.querySelector('#mpPlanBtn');
  var codeBox   = root.querySelector('#mpCodeBox');
  var codeInput = root.querySelector('#mpCodeInput');
  var codeApply = root.querySelector('#mpCodeApply');
  var codeMsg   = root.querySelector('#mpCodeMsg');
  var calBtn    = root.querySelector('#mpCalBtn');

  var activeCode = null;

  /* Same normalisation as the other questionnaires: people type O for 0
     and l for 1, and a rejected valid code is a lost booking. */
  function normaliseCode(raw){
    return String(raw || '')
      .toUpperCase()
      .replace(/[\s\-_.]/g, '')
      .replace(/O/g, '0').replace(/[IL]/g, '1').replace(/S/g, '5');
  }
  var CODE_LOOKUP = {};
  Object.keys(PLAN_CODES).forEach(function(c){ CODE_LOOKUP[normaliseCode(c)] = c; });

  /* Which Mini Valet appointment matches what they picked here. Mirrors
     the Mini Valet's own key logic exactly, so the two can't diverge. */
  function miniKey(){
    var hasWax = state.wax === 'yes';
    if(state.deep !== 'yes')    return hasWax ? 'wax' : 'base';
    if(state.stains !== 'yes')  return hasWax ? 'deep_wax' : 'deep';
    if(state.full === 'yes')    return hasWax ? 'deep_extract_wax' : 'deep_extract';
    return hasWax ? 'deep_stains_wax' : 'deep_stains';
  }

  function planBookingUrl(){
    var size = SIZE_MAP[state.vehicle];
    var id   = (size && MINI_ACUITY[size]) ? MINI_ACUITY[size][miniKey()] : null;
    var url  = ACUITY_BASE + '?appointmentType=' + encodeURIComponent(id || ACUITY_QUOTE);
    if(activeCode) url += '&certificate=' + encodeURIComponent(activeCode);
    var g = (function(){ try{ return sessionStorage.getItem('captured_gclid'); }catch(e){ return null; } })();
    if(g) url += '&' + encodeURIComponent('field:18506559') + '=' + encodeURIComponent(g);
    return url;
  }

  function lockCalendar(){
    activeCode = null;
    if(!calBtn) return;
    calBtn.classList.remove('is-live');
    calBtn.setAttribute('aria-disabled', 'true');
    calBtn.setAttribute('href', '#');
    calBtn.textContent = 'View Calendar';
  }

  function unlockCalendar(code){
    activeCode = code;
    if(!calBtn) return;
    calBtn.classList.add('is-live');
    calBtn.setAttribute('aria-disabled', 'false');
    calBtn.setAttribute('href', planBookingUrl());
    calBtn.textContent = 'View Calendar \u2014 ' + PLAN_CODES[code].off + '% off applied';
  }

  if(planBtn && codeBox){
    planBtn.addEventListener('click', function(){
      var open = codeBox.hasAttribute('hidden');
      if(open){ codeBox.removeAttribute('hidden'); } else { codeBox.setAttribute('hidden',''); }
      planBtn.classList.toggle('is-open', open);
      planBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
      if(open && codeInput) codeInput.focus();
    });
  }

  function tryCode(){
    if(!codeInput || !codeMsg) return;
    var raw = codeInput.value.trim();
    if(!raw){
      codeMsg.className = 'plan-code-msg bad';
      codeMsg.textContent = 'Enter the code we gave you.';
      lockCalendar();
      return;
    }
    var match = CODE_LOOKUP[normaliseCode(raw)];
    if(!match){
      codeMsg.className = 'plan-code-msg bad';
      /* say plainly that seasonal codes don't work here, since AUTUMN20 is
         the one people will most likely try */
      /* Deliberately vague. Naming the prefix, or showing a real code as
         a placeholder, would let anyone guess their way to plan pricing
         without being on the plan. */
      codeMsg.textContent = normaliseCode(raw).indexOf('AUTUMN') === 0
        ? 'That\u2019s a seasonal offer code, not a plan code.'
        : 'We don\u2019t recognise that code. Check it, or call us on 07592 196929.';
      lockCalendar();
      return;
    }
    /* The FREQUENCY chosen in question 2 is the plan they're on, and the
       code has to match it. Anything else is either the wrong code or the
       wrong frequency, and we shouldn't guess which.

       An earlier version silently moved question 2 to match the code —
       which meant someone on the 4-6 week plan could type a 2-3 week code
       and get 5% more off. Rejecting is the only safe direction. */
    var needFreq = PLAN_CODES[match].freq;

    if(state.freq !== needFreq){
      var picked = PLAN_CONFIG.freq[state.freq];
      codeMsg.className = 'plan-code-msg bad';
      codeMsg.textContent =
        'That code is for the ' + PLAN_CODES[match].label + ' plan, but you\u2019ve chosen ' +
        (picked ? picked.label.toLowerCase() : 'a different frequency') +
        '. Change the frequency above, or enter the code for the plan you\u2019re on.';
      lockCalendar();
      return;
    }

    codeMsg.className = 'plan-code-msg good';
    codeMsg.textContent = 'Code applied \u2014 ' + PLAN_CODES[match].off + '% off, ' +
                          PLAN_CODES[match].label + '. Calendar unlocked below.';

    unlockCalendar(match);
  }

  if(codeApply) codeApply.addEventListener('click', tryCode);
  if(codeInput){
    codeInput.addEventListener('keydown', function(e){
      if(e.key === 'Enter'){ e.preventDefault(); tryCode(); }
    });
    /* changing the code invalidates the unlocked calendar */
    codeInput.addEventListener('input', function(){
      if(activeCode) lockCalendar();
    });
  }

  if(calBtn){
    calBtn.addEventListener('click', function(e){
      if(!activeCode){
        e.preventDefault();
        if(codeBox && codeBox.hasAttribute('hidden') && planBtn) planBtn.click();
        if(codeMsg){
          codeMsg.className = 'plan-code-msg bad';
          codeMsg.textContent = 'Enter your plan code first to unlock the calendar.';
        }
        return;
      }
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        event:'pf_book_click', component:'maintenance_plan',
        plan_code:activeCode, vehicle_type:state.vehicle,
        frequency:state.freq, destination_url:calBtn.getAttribute('href')
      });
    });
  }

  /* If they change an answer after unlocking, the link must follow. And if
     they change the FREQUENCY, the code no longer matches the price on
     screen — so re-lock and make them re-enter it. */
  function refreshPlanLink(){
    if(!activeCode || !calBtn) return;

    if(PLAN_CODES[activeCode].freq !== state.freq){
      lockCalendar();
      if(codeMsg){
        codeMsg.className = 'plan-code-msg bad';
        codeMsg.textContent = 'You changed how often we come, so that code no longer applies. ' +
                              'Enter the code for your new frequency.';
      }
      return;
    }
    calBtn.setAttribute('href', planBookingUrl());
  }

  function renderProg(){
    buildProg();
    if(!progTrack) return;
    var segs = progTrack.children;
    for(var i = 0; i < segs.length; i++){
      segs[i].className = 'prog-seg' +
        (i < state.step ? ' done' : i === state.step ? ' now' : '');
    }
    if(progStep)  progStep.textContent  = 'Step ' + (state.step + 1) + ' of ' + STEP_COUNT;
    if(progLabel) progLabel.textContent = PROG_LABELS[state.step] || '';
  }

  function renderDots(){
    if(!dotsEl) return;
    if(!_dots) buildDots();
    _dots.forEach(function(d,i){ d.classList.toggle('on', i === state.step); });
  }

  function isAnswered(i){
    if(i === 0) return !!state.vehicle;
    if(i === 1) return !!state.freq;
    if(i === 2) return !!state.deep;
    if(i === 3) return !!state.stains;
    if(i === 4) return !!state.full;
    if(i === 5) return !!state.wax;
    return true;
  }

  function clearStep(i){
    var s = steps[i];
    if(s) s.querySelectorAll('.opt[role="option"]').forEach(function(o){ o.setAttribute('aria-selected','false'); });
  }

  function goTo(i){
    state.step = Math.max(0, Math.min(STEP_COUNT - 1, i));
    track.style.willChange = 'transform';
    track.style.transform  = 'translateX(-' + (state.step * 100) + '%)';
    clearTimeout(_wc);
    _wc = setTimeout(function(){ track.style.willChange = 'auto'; }, 500);

    root.classList.toggle('is-done', state.step === STEP_COUNT - 1);
    root.classList.toggle('is-first', state.step === 0);
    renderDots();
    renderProg();
    refreshPlanLink();
    btnBack.disabled = state.step === 0;
    if(btnNext) btnNext.disabled = !isAnswered(state.step) || state.step === STEP_COUNT - 1;
    update();
    syncViewportHeight();
    if(state.step > 0) scrollToWidgetTop();

    if(_hasNavigated){
      var h = steps[state.step].querySelector('h3');
      if(h){
        h.setAttribute('tabindex','-1');
        try{ h.focus({ preventScroll:true }); }catch(e){}
      }
    }
    _hasNavigated = true;
  }

  root.querySelectorAll('.opt[role="option"]').forEach(function(opt){
    opt.addEventListener('click', function(){ activate(opt); });
    opt.addEventListener('keydown', function(e){
      if(e.key === 'Enter' || e.key === ' '){ e.preventDefault(); activate(opt); }
    });
  });

  function activate(opt){
    var pick = opt.getAttribute('data-pick');
    state[pick] = opt.getAttribute('data-value');

    if(pick === 'vehicle'){
      state.freq = state.deep = state.stains = state.full = state.wax = null;
      clearStep(1); clearStep(2); clearStep(3); clearStep(4); clearStep(5);
    }
    if(pick === 'freq'){
      state.deep = state.stains = state.full = state.wax = null;
      clearStep(2); clearStep(3); clearStep(4); clearStep(5);
    }

    /* full interior is an upgrade from seats-only, so it implies seats */
    if(pick === 'full' && opt.getAttribute('data-value') === 'yes' && state.stains !== 'yes'){
      state.stains = 'yes';
      var sEl = steps[3] && steps[3].querySelector('.opt[data-pick="stains"][data-value="yes"]');
      if(sEl){ clearStep(3); sEl.setAttribute('aria-selected','true'); }
    }
    /* ...and dropping seats drops the upgrade with it */
    if(pick === 'stains' && opt.getAttribute('data-value') === 'no' && state.full === 'yes'){
      state.full = null;
      clearStep(4);
    }

    var idx = Number(opt.closest('.step').getAttribute('data-step'));
    clearStep(idx);
    opt.setAttribute('aria-selected','true');

    update();

    /* "less often" has nothing left to ask — go straight to the answer */
    if(pick === 'freq' && state.freq === 'rare'){ goTo(STEP_COUNT - 1); return; }

    if(state.step < STEP_COUNT - 1) goTo(state.step + 1);
  }

  btnBack.addEventListener('click', function(){ if(state.step > 0) goTo(state.step - 1); });
  if(btnNext) btnNext.addEventListener('click', function(){
    if(isAnswered(state.step) && state.step < STEP_COUNT - 1) goTo(state.step + 1);
  });

  if(resetBtn) resetBtn.addEventListener('click', function(){
    state = { step:0, vehicle:null, freq:null, deep:null, stains:null, full:null, wax:null };
    steps.forEach(function(s){ s.querySelectorAll('.opt[role="option"]').forEach(function(o){ o.setAttribute('aria-selected','false'); }); });
    goTo(0);
  });

  doneBtn.addEventListener('click', function(){
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({
      event:           'pf_plan_click',
      component:       'maintenance_plan',
      vehicle_type:    state.vehicle || null,
      frequency:       state.freq    || null,
      discount_pct:    offPct(),
      deep_clean:      state.deep    || null,
      seat_stains:     state.stains  || null,
      full_interior:   state.full    || null,
      wax:             state.wax     || null,
      plan_price:      planPrice(),
      routed_away:     isRare(),
      destination_url: doneBtn.getAttribute('href')
    });
  });

  buildDots();
  goTo(0);

  /* =====================================================================
     Landing position
     The reviews badge loads late and the wizard height drops from
     "tallest step" to "step one", so the page can settle part-way down.
     After it settles we put it back at the top — but only if the person
     hasn't touched anything yet, and only if there's no #hash to honour.
     ===================================================================== */
  var _touched = false;
  ['touchstart','wheel','keydown','pointerdown','mousedown'].forEach(function(ev){
    window.addEventListener(ev, function(){ _touched = true; }, { once:true, passive:true });
  });

  function settleAtTop(){
    if(_touched) return;
    if(window.location.hash) return;
    if(window.pageYOffset <= 4) return;
    window.scrollTo(0, 0);
  }

  window.addEventListener('load', function(){ syncViewportHeight(); settleAtTop(); });
  setTimeout(function(){ syncViewportHeight(); settleAtTop(); }, 250);
  setTimeout(settleAtTop, 700);   /* after the reviews badge has rendered */
})();
</script>
