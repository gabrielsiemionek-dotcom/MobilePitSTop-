              <div class="plan-code-row">
                <input type="text" id="mpCodeInput" placeholder="Enter your code"
                       autocomplete="off" autocapitalize="characters" spellcheck="false"
                       aria-label="Maintenance plan discount code">
                <button type="button" id="mpCodeApply">Apply</button>
              </div>
              <div class="plan-code-msg" id="mpCodeMsg" aria-live="polite"></div>
            </div>

            <a class="btn-cal" id="mpCalBtn" href="#" aria-disabled="true"
               role="button">View Calendar</a>

            <div class="bd" id="mpBreakdown"></div>

            <div id="mpReroute"></div>

            <div style="margin-top:12px; color:#bdbdbd; font-size:13px; line-height:1.5;" id="mpHint"></div>
          </div>
