<!-- ==========================================================================
     MobilePitStop — Homepage: "Our Approach to Car Detailing"
     Replaces the old tabbed service widget. Paste into ONE Code Block.

     Namespaced .mph- so it can't clash with the All Services page (.mps-)
     or with Squarespace's own styles. No fonts or scripts loaded from
     outside.

     NO LAYOUT DEPENDS ON JAVASCRIPT. The only script adds a gentle
     slide-up as each block scrolls into view; if it fails, everything is
     simply visible. Every image has a fixed shape (aspect-ratio), so
     Squarespace measures the right height on the first paint.

     IMAGES: the four below are already on your site. Swap any URL for a
     better shot — keep the ?format=800w on the end.

     SERVICE LIST PRICES are the "from" price on each service page and the
     All Services page (https://mobilepitstop.uk/all-services). If a price
     changes there, change it here too.
     LINKS: live service pages where they exist; otherwise the matching
     section of /all-services. Garage links (#correction, #ppf, #wrap,
     #tint, #dechrome) open the All Services page on its Garage half.
     ========================================================================== -->

<style>
.mph{
  --mph-ink:#ffffff;
  --mph-dim:rgba(255,255,255,.66);
  --mph-faint:rgba(255,255,255,.38);
  --mph-line:rgba(255,255,255,.13);
  --mph-yellow:#E3FC02;
  --mph-blue:#00B8FF;

  color:var(--mph-ink);
  font-family:system-ui,-apple-system,"Segoe UI",Roboto,Inter,Arial,sans-serif;
  -webkit-font-smoothing:antialiased;
  max-width:980px;
  margin:0 auto;
  padding:0 2px;
  text-align:left;
}
.mph *{box-sizing:border-box;}

/* ---------- heading ---------- */
.mph h2.mph-h2{
  font-size:clamp(27px,6.6vw,42px);
  font-weight:900;
  letter-spacing:-.025em;
  line-height:1.08;
  text-align:center;
  margin:0 0 10px;
  color:var(--mph-ink);
}
.mph-motto{
  text-align:center;
  font-size:15px;
  font-weight:800;
  letter-spacing:.01em;
  color:var(--mph-yellow);
  margin:0 0 34px;
}

/* ---------- the four blocks ---------- */
.mph-blocks{display:grid;gap:34px;margin:0 0 44px;}

.mph-block{
  display:grid;
  gap:16px;
  align-items:center;
}
.mph-img{
  margin:0;
  border-radius:16px;
  overflow:hidden;
  border:1px solid var(--mph-line);
  background:#111;
  aspect-ratio:16/10;
}
.mph-img img{
  display:block;
  width:100%;
  height:100%;
  object-fit:cover;
}
.mph-n{
  display:inline-block;
  font-size:12px;
