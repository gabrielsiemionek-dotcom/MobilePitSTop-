<script>
(function(){
  var root = document.querySelector('.mph');
  if(!root || !('IntersectionObserver' in window)) return;
  if(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

  var blocks = root.querySelectorAll('.mph-block');
  root.classList.add('mph-anim');

  var heard = false;
  var io = new IntersectionObserver(function(entries){
    heard = true;
    entries.forEach(function(e){
      if(e.isIntersecting){
        e.target.classList.add('mph-in');
        io.unobserve(e.target);
      }
    });
  }, { rootMargin: '0px 0px -12% 0px', threshold: 0.08 });

  for(var i = 0; i < blocks.length; i++) io.observe(blocks[i]);

  /* safety net: the observer always reports once straight away. If it
     never does (some editor previews), show everything rather than
     leave the blocks invisible. */
  setTimeout(function(){
    if(heard) return;
    for(var j = 0; j < blocks.length; j++) blocks[j].classList.add('mph-in');
  }, 1500);
})();
</script>
