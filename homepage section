}
.mph-block p{
  font-size:15px;
  line-height:1.65;
  color:var(--mph-dim);
  margin:0 0 14px;
  max-width:56ch;
}
.mph-chips{
  display:flex;
  flex-wrap:wrap;
  gap:7px;
  list-style:none;
  margin:0;
  padding:0;
}
.mph-chips li{
  padding:6px 11px;
  border:1px solid var(--mph-line);
  border-radius:999px;
  background:rgba(255,255,255,.03);
  font-size:12.5px;
  font-weight:700;
  line-height:1.2;
  color:rgba(255,255,255,.82);
}

/* ---------- compact service list ----------
   Plain links in a div rather than a <ul>: Squarespace's own list styles
   were forcing one pill per row. The !important flags hold the layout
   against those site-wide styles. */
.mph-svc{
  border-top:1px solid var(--mph-line);
  padding-top:24px;
  margin:0 0 24px;
}
.mph .mph-svc-h{
  display:flex !important;
  align-items:center;
  justify-content:center;
  gap:8px;
  font-size:13px !important;
  font-weight:900 !important;
  letter-spacing:.12em !important;
  text-transform:uppercase;
  line-height:1.2 !important;
  color:#ffffff !important;
  text-align:center;
  margin:0 0 12px !important;
}
.mph-svc-h svg{
  width:19px;
  height:19px;
  flex:0 0 19px;
  stroke:var(--mph-yellow);
  fill:none;
  stroke-width:1.7;
  stroke-linecap:round;
  stroke-linejoin:round;
}
.mph .mph-svc-note{
  text-align:center;
  font-size:12.5px !important;
  line-height:1.4 !important;
  color:rgba(255,255,255,.5) !important;
  margin:-6px 0 12px !important;
}
.mph-pills{
  display:flex !important;
  flex-wrap:wrap !important;
  justify-content:center;
  gap:7px;
  margin:0 0 22px;
  padding:0;
}
.mph-pills:last-child{margin-bottom:0;}
.mph .mph-pills a{
  display:inline-flex !important;
  align-items:baseline;
  gap:7px;
  width:auto !important;
  padding:8px 13px;
  border:1px solid var(--mph-line);
  border-radius:999px;
  background:rgba(255,255,255,.03);
  font-size:13.5px;
  font-weight:700;
  line-height:1.2;
  color:#ffffff !important;
  text-decoration:none !important;
  white-space:nowrap;
  transition:border-color .15s ease,background .15s ease;
}
.mph-pills a b{color:var(--mph-yellow);font-weight:900;font-size:12.5px;}
.mph-pills a .mph-q{
  color:var(--mph-yellow);
  font-size:10.5px;
  font-weight:900;
  letter-spacing:.07em;
  text-transform:uppercase;
}
.mph .mph-pills a:hover,.mph .mph-pills a:focus-visible{
  border-color:rgba(227,252,2,.5);
  background:rgba(227,252,2,.07);
}

/* ---------- CTA ---------- */
.mph-cta{text-align:center;margin:0;}
.mph-go{
  display:inline-block;
  padding:15px 34px;
  border-radius:999px;
  background:linear-gradient(135deg,#E3FC02 0%,#d6ff6b 100%);
  color:#0b0b0b;
  font-size:16px;
  font-weight:900;
  letter-spacing:.005em;
  text-decoration:none;
  box-shadow:0 8px 22px rgba(227,252,2,.24);
  transition:transform .15s ease,box-shadow .15s ease;
}
.mph-go:hover,.mph-go:focus-visible{
  transform:translateY(-1px);
  box-shadow:0 12px 28px rgba(227,252,2,.34);
  color:#0b0b0b;
}

/* ---------- desktop: image and text side by side, alternating ---------- */
@media (min-width:760px){
  .mph-blocks{gap:46px;}
  .mph-block{grid-template-columns:1fr 1fr;gap:38px;}
  .mph-block:nth-child(even) .mph-img{order:2;}
}

/* ---------- slide-up as blocks enter (only when the script runs) ---------- */
.mph.mph-anim .mph-block{
  opacity:0;
  transform:translateY(22px);
  transition:opacity .55s ease,transform .55s ease;
}
.mph.mph-anim .mph-block.mph-in{opacity:1;transform:none;}

@media (max-width:640px){
  .mph-go{display:block;}
}
@media (prefers-reduced-motion:reduce){
  .mph.mph-anim .mph-block{opacity:1;transform:none;transition:none;}
  .mph *{transition:none !important;}
}
</style>


